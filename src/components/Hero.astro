---
import { Image } from "astro:assets";
import hotStones from "../assets/images/manos sagradas masajes 03.webp";
import hotStones2 from "../assets/images/manos sagradas masajes 01.webp";

// Agregar más imágenes a este array cuando estén disponibles (mínimo 4 para el slider final).
const slides = [hotStones, hotStones2];

const whatsappNumber = "51907529233";
const whatsappMessage = encodeURIComponent(
  "¡Hola! Me gustaría reservar una cita para un masaje.",
);
const whatsappHref = `https://wa.me/${whatsappNumber}?text=${whatsappMessage}`;
---

<section
  class="relative h-screen min-h-[600px] w-full overflow-hidden bg-primary-dark"
>
  <div
    class="hero-swiper swiper h-full w-full"
    data-slide-count={slides.length}
  >
    <div class="swiper-wrapper">
      {
        slides.map((src) => (
          <div class="swiper-slide relative">
            <Image
              src={src}
              alt="Terapia de masaje con piedras calientes en Manos Sagradas Masajes"
              class="h-full w-full object-cover"
              widths={[640, 1024, 1600, 1920]}
              sizes="100vw"
            />
            <div class="absolute inset-0 bg-gradient-to-t from-primary-dark/85 via-primary-dark/45 to-primary-dark/25" />
          </div>
        ))
      }
    </div>
    <div class="hero-swiper-pagination swiper-pagination z-20"></div>
  </div>

  <div
    class="pointer-events-none absolute inset-0 z-10 flex items-center justify-center px-6 text-center"
  >
    <div class="max-w-2xl">
      <h1
        class="font-display text-4xl font-semibold leading-tight text-surface sm:text-5xl lg:text-6xl"
      >
        Recupera tu equilibrio, cuerpo y mente
      </h1>
      <p class="mx-auto mt-5 max-w-xl text-base text-background-alt sm:text-lg">
        En Manos Sagradas Masajes te ofrecemos terapias personalizadas para
        liberar el estrés, aliviar la tensión y renovar tu energía.
      </p>
      <a
        href={whatsappHref}
        target="_blank"
        rel="noopener noreferrer"
        class="pointer-events-auto mt-8 inline-block rounded-full bg-gold px-8 py-3 text-sm font-semibold tracking-wide text-surface transition-colors hover:bg-gold-dark sm:text-base"
      >
        Reserva tu cita
      </a>
    </div>
  </div>
</section>

<style>
  .hero-swiper :global(.swiper-pagination-bullet) {
    background-color: var(--color-background);
    opacity: 0.6;
  }
  .hero-swiper :global(.swiper-pagination-bullet-active) {
    background-color: var(--color-gold);
    opacity: 1;
  }
</style>

<script>
  import Swiper from "swiper";
  import { Autoplay, EffectFade, Pagination } from "swiper/modules";
  import "swiper/css";
  import "swiper/css/effect-fade";
  import "swiper/css/pagination";

  const el = document.querySelector<HTMLElement>(".hero-swiper");
  if (el) {
    const slideCount = Number(el.dataset.slideCount ?? "1");
    new Swiper(el, {
      modules: [Autoplay, EffectFade, Pagination],
      effect: "fade",
      fadeEffect: { crossFade: true },
      speed: 1000,
      loop: slideCount > 1,
      autoplay:
        slideCount > 1 ? { delay: 4000, disableOnInteraction: false } : false,
      pagination: { el: ".hero-swiper-pagination", clickable: true },
    });
  }
</script>

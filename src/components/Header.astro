---
import { Image } from "astro:assets";
import logo from "../assets/icons/Logo_manos_sagradas.webp";

const navLinks = [
  { label: "Nosotros", href: "#nosotros" },
  { label: "Servicios", href: "#servicios" },
  { label: "Contáctanos", href: "#contactanos" },
  { label: "Galería", href: "#galeria" },
];

const whatsappNumber = "51907529233";
const whatsappMessage = encodeURIComponent(
  "¡Hola! Me gustaría saber más sobre sus masajes, ¿me pueden ayudar?",
);
const whatsappHref = `https://wa.me/${whatsappNumber}?text=${whatsappMessage}`;

const socialLinks = [
  { name: "Facebook", href: "https://www.facebook.com/ManosSagradasMasajes/" },
  {
    name: "Instagram",
    href: "https://www.instagram.com/manossagradasmasajes/",
  },
  { name: "TikTok", href: "https://www.tiktok.com/@manossagradasmasajes" },
  { name: "WhatsApp", href: whatsappHref },
];
---

<header class="absolute inset-x-0 top-0 z-30 w-full">
  <div
    class="mx-auto flex max-w-7xl items-center justify-between gap-4 px-6 py-5 lg:grid lg:grid-cols-3 lg:px-10"
  >
    <a
      href="/"
      class="flex items-center lg:justify-self-start"
      aria-label="Manos Sagradas Masajes, ir al inicio"
    >
      <Image
        src={logo}
        alt="Manos Sagradas Masajes"
        width={128}
        height={128}
        class="h-12 w-12 object-contain lg:h-18 lg:w-18"
      />
    </a>

    <nav class="hidden lg:flex lg:justify-self-center lg:gap-10">
      {
        navLinks.map((link) => (
          <a
            href={link.href}
            class="text-sm uppercase font-medium tracking-wide text-surface transition-colors hover:text-gold-light"
          >
            {link.label}
          </a>
        ))
      }
    </nav>

    <div class="flex items-center gap-3 sm:gap-4 lg:justify-self-end lg:gap-6">
      <div class="flex items-center gap-3 sm:gap-4">
        {
          socialLinks.map((social) => (
            <a
              href={social.href}
              target="_blank"
              rel="noopener noreferrer"
              aria-label={social.name}
              class="text-surface transition-colors hover:text-gold-light"
            >
              {social.name === "Facebook" && (
                <svg
                  viewBox="0 0 24 24"
                  fill="currentColor"
                  class="h-5 w-5"
                  aria-hidden="true"
                >
                  <path d="M22 12.06C22 6.505 17.523 2 12 2S2 6.505 2 12.06c0 5.02 3.657 9.184 8.438 9.94v-7.03H7.898v-2.91h2.54V9.845c0-2.507 1.492-3.89 3.777-3.89 1.094 0 2.238.195 2.238.195v2.46h-1.26c-1.243 0-1.63.771-1.63 1.562v1.876h2.773l-.443 2.91h-2.33V22c4.78-.756 8.437-4.92 8.437-9.94Z" />
                </svg>
              )}
              {social.name === "Instagram" && (
                <svg
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.6"
                  class="h-5 w-5"
                  aria-hidden="true"
                >
                  <rect x="3" y="3" width="18" height="18" rx="5" />
                  <circle cx="12" cy="12" r="4" />
                  <circle
                    cx="17.2"
                    cy="6.8"
                    r="1"
                    fill="currentColor"
                    stroke="none"
                  />
                </svg>
              )}
              {social.name === "TikTok" && (
                <svg
                  viewBox="0 0 24 24"
                  fill="currentColor"
                  class="h-5 w-5"
                  aria-hidden="true"
                >
                  <path d="M16.6 3h-3.2v12.6a2.7 2.7 0 1 1-2.2-2.65v-3.24a6 6 0 1 0 5.4 5.97V9.1a6.9 6.9 0 0 0 4.1 1.34V7.24A3.9 3.9 0 0 1 16.6 3Z" />
                </svg>
              )}
              {social.name === "WhatsApp" && (
                <svg
                  viewBox="0 0 24 24"
                  fill="currentColor"
                  class="h-5 w-5"
                  aria-hidden="true"
                >
                  <path d="M12.04 2c-5.5 0-9.96 4.46-9.96 9.96 0 1.76.46 3.48 1.34 5L2 22l5.2-1.36a9.9 9.9 0 0 0 4.84 1.23h.01c5.5 0 9.96-4.45 9.96-9.95S17.54 2 12.04 2Zm5.8 14.24c-.24.68-1.4 1.3-1.94 1.38-.5.08-1.12.11-1.8-.12a17 17 0 0 1-1.87-.7 12.7 12.7 0 0 1-4.9-4.34c-.6-.82-1-1.75-1-2.7 0-.9.47-1.36.8-1.7.2-.2.44-.28.6-.28h.42c.14 0 .33-.02.5.4.2.5.66 1.7.72 1.83.06.13.1.28.02.44-.08.16-.13.27-.26.42-.14.14-.28.32-.4.43-.13.13-.27.28-.12.55.16.28.7 1.14 1.5 1.85 1.03.92 1.9 1.2 2.18 1.34.28.13.44.11.6-.06.17-.18.7-.8.9-1.08.19-.28.38-.23.63-.14.26.1 1.6.75 1.87.89.28.13.46.2.53.31.07.12.07.68-.17 1.36Z" />
                </svg>
              )}
            </a>
          ))
        }
      </div>

      <button
        id="menu-open"
        type="button"
        class="flex items-center justify-center text-surface lg:hidden"
        aria-label="Abrir menú"
        aria-controls="mobile-menu"
        aria-expanded="false"
      >
        <svg
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.8"
          stroke-linecap="round"
          class="h-6 w-6"
          aria-hidden="true"
        >
          <path d="M4 6h16M4 12h16M4 18h16"></path>
        </svg>
      </button>
    </div>
  </div>

  <div id="menu-backdrop" class="fixed inset-0 z-40 hidden bg-primary-dark/60">
  </div>

  <aside
    id="mobile-menu"
    class="fixed inset-y-0 right-0 z-50 flex h-full w-full max-w-xs translate-x-full flex-col bg-surface shadow-2xl transition-transform duration-300 ease-in-out"
  >
    <div class="flex items-center justify-between px-6 py-5">
      <Image
        src={logo}
        alt="Manos Sagradas Masajes"
        width={48}
        height={48}
        class="h-11 w-11 object-contain"
      />
      <button
        id="menu-close"
        type="button"
        class="text-text transition-colors hover:text-gold-dark"
        aria-label="Cerrar menú"
      >
        <svg
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.8"
          stroke-linecap="round"
          class="h-6 w-6"
          aria-hidden="true"
        >
          <path d="M6 6l12 12M18 6L6 18"></path>
        </svg>
      </button>
    </div>
    <nav class="flex flex-col px-6 py-2">
      {
        navLinks.map((link) => (
          <a
            href={link.href}
            class="border-b border-background-alt py-4 text-base font-medium tracking-wide text-text transition-colors hover:text-gold-dark"
          >
            {link.label}
          </a>
        ))
      }
    </nav>
  </aside>
</header>

<script>
  const openBtn = document.getElementById("menu-open");
  const closeBtn = document.getElementById("menu-close");
  const backdrop = document.getElementById("menu-backdrop");
  const menu = document.getElementById("mobile-menu");

  function openMenu() {
    menu?.classList.remove("translate-x-full");
    backdrop?.classList.remove("hidden");
    openBtn?.setAttribute("aria-expanded", "true");
    document.body.classList.add("overflow-hidden");
  }

  function closeMenu() {
    menu?.classList.add("translate-x-full");
    backdrop?.classList.add("hidden");
    openBtn?.setAttribute("aria-expanded", "false");
    document.body.classList.remove("overflow-hidden");
  }

  openBtn?.addEventListener("click", openMenu);
  closeBtn?.addEventListener("click", closeMenu);
  backdrop?.addEventListener("click", closeMenu);
  document.addEventListener("keydown", (event) => {
    if (event.key === "Escape") closeMenu();
  });
  menu
    ?.querySelectorAll("a")
    .forEach((link) => link.addEventListener("click", closeMenu));
</script>

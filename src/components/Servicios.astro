---
import { getCollection } from "astro:content";
import { Image } from "astro:assets";
import Titulo from "./Titulo.astro";

const whatsappNumber = "51907529233";

function whatsappHref(mensaje: string) {
  return `https://wa.me/${whatsappNumber}?text=${encodeURIComponent(mensaje)}`;
}

// Orden fijo de la sección "Elige tu momento sagrado", igual al que ya usa la página de cada servicio.
const ordenServicios = [
  "relajante",
  "descontracturante",
  "terapeutico",
  "drenaje-linfatico",
  "reflexologia-podal",
  "reflexologia-mas-masaje-piernas",
  "piedras-calientes",
  "prenatal",
  "alineacion-de-chacras",
];

const todosLosServicios = await getCollection("servicios");
const serviciosOrdenados = ordenServicios
  .map((slug) => todosLosServicios.find((entry) => entry.id === slug))
  .filter((entry): entry is (typeof todosLosServicios)[number] =>
    Boolean(entry),
  );

// Máximo 10 tarjetas en total; se reserva un puesto para la tarjeta "¿Buscas algo más?".
const servicios = serviciosOrdenados.slice(0, 9);
---

<section id="servicios" class="bg-background py-12 sm:py-16">
  <div class="mx-auto max-w-7xl px-6 lg:px-10">
    <div class="mx-auto max-w-2xl text-center">
      <span
        class="text-xs font-semibold uppercase tracking-wide text-gold"
        data-reveal="fade-up"
      >
        Elige tu momento sagrado
      </span>
      <div class="mt-2" data-reveal="fade-up" style="--reveal-delay: 100ms">
        <Titulo parte1="Nuestras" parte2="terapias" />
      </div>
      <p
        class="mt-4 text-base text-text-muted sm:text-lg"
        data-reveal="fade-up"
        style="--reveal-delay: 200ms"
      >
        Cada sesión se adapta a ti. Elige la terapia que tu cuerpo necesita hoy,
        o escríbenos y te ayudamos a encontrarla.
      </p>
      <p
        class="mt-4 font-display text-base italic text-primary-light"
        data-reveal="fade-up"
        style="--reveal-delay: 300ms"
      >
        Porque cuando cuidas de ti, todo fluye mejor.
      </p>
    </div>

    <div class="servicios-swiper swiper mt-12">
      <div class="swiper-wrapper">
        {
          servicios.map((servicio, index) => {
            const categoria = servicio.data.categorias[0];
            return (
              <div
                class="swiper-slide h-auto"
                data-reveal="fade-up"
                style={`--reveal-delay: ${Math.min(index * 90, 450)}ms`}
              >
                <a
                  href={`/servicios/${servicio.id}`}
                  class="group flex h-full flex-col overflow-hidden rounded-lg bg-surface shadow-lg outline-none transition-shadow duration-300 hover:shadow-xl focus-visible:ring-2 focus-visible:ring-gold"
                >
                  <div class="relative">
                    <div class="overflow-hidden rounded-t-lg">
                      <Image
                        src={servicio.data.imagenDestacada}
                        alt={`Terapia de ${servicio.data.titulo.toLowerCase()} en Manos Sagradas Masajes`}
                        class="aspect-[4/3] w-full object-cover transition-transform duration-500 group-hover:scale-105"
                        widths={[320, 480, 640]}
                        sizes="(min-width: 1024px) 22rem, 20rem"
                      />
                    </div>
                    {servicio.data.duracion && (
                      <span class="absolute left-4 top-4 inline-flex items-center gap-1.5 rounded-lg bg-primary-dark/75 px-2.5 py-1 text-xs font-semibold text-surface shadow-md backdrop-blur-sm">
                        <svg
                          viewBox="0 0 24 24"
                          fill="none"
                          stroke="currentColor"
                          stroke-width="1.8"
                          stroke-linecap="round"
                          stroke-linejoin="round"
                          class="h-3.5 w-3.5"
                          aria-hidden="true"
                        >
                          <circle cx="12" cy="12" r="9" />
                          <path d="M12 7v5l3 3" />
                        </svg>
                        {servicio.data.duracion}
                      </span>
                    )}
                    {categoria && (
                      <span class="absolute -bottom-4 left-6 inline-flex items-center rounded-lg bg-gold px-4 py-2 text-xs font-semibold uppercase tracking-wide text-surface shadow-md">
                        {categoria}
                      </span>
                    )}
                    <span
                      class="absolute right-4 top-4 flex h-9 w-9 items-center justify-center rounded-full bg-surface/90 text-primary shadow-md backdrop-blur-sm transition-all duration-300 group-hover:-translate-y-0.5 group-hover:translate-x-0.5 group-hover:bg-gold group-hover:text-surface"
                      aria-hidden="true"
                    >
                      <svg
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="1.8"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        class="h-4 w-4"
                        aria-hidden="true"
                      >
                        <path d="M7 17 17 7" />
                        <path d="M8 7h9v9" />
                      </svg>
                    </span>
                  </div>
                  <div class="flex flex-1 flex-col px-6 pb-6 pt-9">
                    <h3 class="font-display text-xl font-semibold text-text">
                      {servicio.data.titulo}
                    </h3>
                    <p class="mt-2 text-sm leading-relaxed text-text-muted">
                      {servicio.data.descripcionCorta}
                    </p>
                  </div>
                </a>
              </div>
            );
          })
        }

        <div
          class="swiper-slide h-auto"
          data-reveal="fade-up"
          style={`--reveal-delay: ${Math.min(servicios.length * 90, 450)}ms`}
        >
          <a
            href={whatsappHref(
              "¡Hola! Busco un masaje y quisiera saber qué me recomiendan.",
            )}
            target="_blank"
            rel="noopener noreferrer"
            class="stall-cta flex h-full flex-col justify-center rounded-lg border border-gold/40 bg-primary p-8 text-center shadow-lg transition-transform duration-300 hover:-translate-y-1"
          >
            <p class="font-display text-xl text-surface">¿Buscas algo más?</p>
            <p class="mt-2 text-sm text-background-alt">
              Escríbenos y te ayudamos a encontrar la terapia ideal para ti.
            </p>
            <span
              class="mt-4 text-xs font-semibold uppercase tracking-wide text-gold-light"
            >
              Escribir por WhatsApp →
            </span>
          </a>
        </div>
      </div>
    </div>

    <div
      class="servicios-pagination mt-8 flex items-center justify-center gap-2 lg:hidden"
    >
    </div>

    <div class="servicios-nav mt-6 flex justify-center gap-3 lg:hidden">
      <button
        type="button"
        class="servicios-prev flex h-11 w-11 items-center justify-center rounded-lg border border-gold/40 text-primary transition-colors hover:border-gold hover:bg-gold hover:text-surface"
        aria-label="Terapia anterior"
      >
        <svg
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.8"
          stroke-linecap="round"
          stroke-linejoin="round"
          class="h-5 w-5"
          aria-hidden="true"
        >
          <path d="M15 6l-6 6 6 6"></path>
        </svg>
      </button>
      <button
        type="button"
        class="servicios-next flex h-11 w-11 items-center justify-center rounded-lg border border-gold/40 text-primary transition-colors hover:border-gold hover:bg-gold hover:text-surface"
        aria-label="Siguiente terapia"
      >
        <svg
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.8"
          stroke-linecap="round"
          stroke-linejoin="round"
          class="h-5 w-5"
          aria-hidden="true"
        >
          <path d="M9 6l6 6-6 6"></path>
        </svg>
      </button>
    </div>
  </div>
</section>

<style>
  .stall-cta {
    background-image: repeating-linear-gradient(
      135deg,
      var(--color-gold-dark) 0,
      var(--color-gold-dark) 2px,
      transparent 2px,
      transparent 12px
    );
    background-blend-mode: overlay;
    background-size: 100% 100%;
  }

  .servicios-prev:global(.swiper-button-disabled),
  .servicios-next:global(.swiper-button-disabled) {
    opacity: 0.3;
    pointer-events: none;
  }

  /* Desde lg ya no es un slide: la pista se convierte en una grilla de 3 columnas (máx. 9 tarjetas). */
  @media (min-width: 1024px) {
    .servicios-swiper :global(.swiper-wrapper) {
      display: grid !important;
      grid-template-columns: repeat(3, 1fr);
      gap: 1.5rem;
      transform: none !important;
    }
    .servicios-swiper :global(.swiper-slide) {
      width: auto !important;
    }
  }

  .servicios-pagination :global(.swiper-pagination-bullet) {
    background-color: var(--color-primary-light);
    opacity: 0.4;
  }
  .servicios-pagination :global(.swiper-pagination-bullet-active) {
    background-color: var(--color-gold);
    opacity: 1;
  }
</style>

<script>
  import Swiper from "swiper";
  import { Navigation, Pagination } from "swiper/modules";
  import "swiper/css";
  import "swiper/css/pagination";

  // Desde lg (1024px) la sección deja de ser un slide y pasa a grilla CSS,
  // así que Swiper solo se activa por debajo de ese ancho.
  const escritorio = window.matchMedia("(min-width: 1024px)");
  let swiper: Swiper | undefined;

  function actualizarSwiper() {
    const el = document.querySelector<HTMLElement>(".servicios-swiper");
    if (!el) return;

    if (escritorio.matches) {
      swiper?.destroy(true, true);
      swiper = undefined;
      return;
    }

    if (!swiper) {
      swiper = new Swiper(el, {
        modules: [Navigation, Pagination],
        slidesPerView: 1.15,
        spaceBetween: 16,
        watchOverflow: true,
        breakpoints: {
          0: { slidesPerView: 1, spaceBetween: 20 },
          768: { slidesPerView: 2.3, spaceBetween: 24 },
        },
        navigation: {
          nextEl: ".servicios-next",
          prevEl: ".servicios-prev",
        },
        pagination: {
          el: ".servicios-pagination",
          clickable: true,
        },
      });
    }
  }

  actualizarSwiper();
  escritorio.addEventListener("change", actualizarSwiper);
</script>

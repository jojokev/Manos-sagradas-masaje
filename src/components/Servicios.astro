---
import { Image } from "astro:assets";
import piedrasCalientes from "../assets/images/manos sagradas masajes 03.webp";
import descontracturante from "../assets/images/manos sagradas masajes 01.webp";
import relajante from "../assets/images/manos sagradas masajes 02.webp";
import terapeutico from "../assets/images/manos sagradas masajes 04.webp";
import drenajeLinfatico from "../assets/images/manos sagradas masajes 05.webp";
import prenatal from "../assets/images/manos sagradas masajes 06.webp";

const whatsappNumber = "51907529233";

function whatsappHref(mensaje: string) {
  return `https://wa.me/${whatsappNumber}?text=${encodeURIComponent(mensaje)}`;
}

type Servicio = {
  title: string;
  duracion: string;
  mensaje: string;
  image?: typeof piedrasCalientes;
  icon?: "leaf" | "droplet" | "footprint" | "blossom";
};

const servicios: Servicio[] = [
  {
    title: "Piedras calientes",
    duracion: "60 min",
    image: piedrasCalientes,
    mensaje: "¡Hola! Me interesa el masaje con piedras calientes, ¿me cuentan más?",
  },
  {
    title: "Descontracturante",
    duracion: "45 min",
    image: descontracturante,
    mensaje: "¡Hola! Me interesa el masaje descontracturante, ¿me cuentan más?",
  },
  {
    title: "Relajante",
    duracion: "40 min",
    image: relajante,
    mensaje: "¡Hola! Me interesa el masaje relajante, ¿me cuentan más?",
  },
  {
    title: "Terapéutico",
    duracion: "60 min",
    image: terapeutico,
    icon: "leaf",
    mensaje: "¡Hola! Me interesa el masaje terapéutico, ¿me cuentan más?",
  },
  {
    title: "Drenaje linfático",
    duracion: "45 min",
    image: drenajeLinfatico,
    icon: "droplet",
    mensaje: "¡Hola! Me interesa el masaje de drenaje linfático, ¿me cuentan más?",
  },
  {
    title: "Reflexología podal",
    duracion: "30 min",
    icon: "footprint",
    mensaje: "¡Hola! Me interesa la reflexología podal, ¿me cuentan más?",
  },
  {
    title: "Prenatal",
    duracion: "40 min",
    image: prenatal,
    icon: "blossom",
    mensaje: "¡Hola! Me interesa el masaje prenatal, ¿me cuentan más?",
  },
];
---

<section id="servicios" class="bg-background py-20 sm:py-28">
  <div class="mx-auto max-w-7xl px-6 lg:px-10">
    <div class="flex flex-wrap items-end justify-between gap-6">
      <div class="max-w-2xl">
        <h2 class="font-display text-3xl font-semibold text-text sm:text-4xl">
          Nuestras terapias
        </h2>
        <p class="mt-4 text-base text-text-muted sm:text-lg">
          Cada sesión se adapta a ti. Elige la terapia que tu cuerpo necesita
          hoy, o escríbenos y te ayudamos a encontrarla.
        </p>
      </div>

      <div class="hidden shrink-0 gap-3 sm:flex">
        <button
          type="button"
          class="servicios-prev flex h-11 w-11 items-center justify-center rounded-lg border border-gold/40 text-primary transition-colors hover:border-gold hover:bg-gold hover:text-surface"
          aria-label="Terapia anterior"
        >
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" class="h-5 w-5" aria-hidden="true">
            <path d="M15 6l-6 6 6 6" />
          </svg>
        </button>
        <button
          type="button"
          class="servicios-next flex h-11 w-11 items-center justify-center rounded-lg border border-gold/40 text-primary transition-colors hover:border-gold hover:bg-gold hover:text-surface"
          aria-label="Siguiente terapia"
        >
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" class="h-5 w-5" aria-hidden="true">
            <path d="M9 6l6 6-6 6" />
          </svg>
        </button>
      </div>
    </div>

    <div class="servicios-swiper swiper mt-12">
      <div class="swiper-wrapper">
        {
          servicios.map((servicio) => (
            <div
              tabindex="0"
              class="swiper-slide stall group relative overflow-hidden rounded-lg bg-primary-dark shadow-lg outline-none transition-[transform,opacity] duration-300 focus-visible:ring-2 focus-visible:ring-gold"
            >
              <span class="absolute right-4 top-4 z-10 inline-flex items-center gap-1 rounded-lg border border-gold/50 bg-primary-dark px-3 py-1 text-[11px] font-semibold uppercase tracking-wide text-gold-light">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" class="h-3 w-3" aria-hidden="true">
                  <circle cx="12" cy="12" r="9" />
                  <path d="M12 7v5l3 3" />
                </svg>
                {servicio.duracion}
              </span>
              {servicio.image ? (
                <>
                  <Image
                    src={servicio.image}
                    alt={`Terapia de ${servicio.title.toLowerCase()} en Manos Sagradas Masajes`}
                    class="aspect-[4/5] w-full object-cover transition-transform duration-500 group-hover:scale-105"
                    widths={[400, 640, 800]}
                    sizes="20rem"
                  />
                  <div class="pointer-events-none absolute inset-0 bg-gradient-to-t from-primary-dark/95 via-primary-dark/30 to-transparent" />
                </>
              ) : (
                <div class="stall-texture aspect-[4/5] w-full bg-primary">
                  <div class="flex h-full w-full items-start justify-center pt-10">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" class="h-12 w-12 text-gold-light/70" aria-hidden="true">
                      {servicio.icon === "leaf" && (
                        <>
                          <path d="M6 20c-2-6 0-12 6-14 4 6 4 12 0 14a6 6 0 0 1-6 0Z" />
                          <path d="M12 6c-1 4-1 8 0 14" />
                        </>
                      )}
                      {servicio.icon === "droplet" && (
                        <path d="M12 3c3 4 6 8 6 11a6 6 0 1 1-12 0c0-3 3-7 6-11Z" />
                      )}
                      {servicio.icon === "footprint" && (
                        <>
                          <ellipse cx="12" cy="14.5" rx="4.2" ry="6" />
                          <circle cx="8.6" cy="6.2" r="1" />
                          <circle cx="10.8" cy="4.4" r="1" />
                          <circle cx="13.2" cy="4.1" r="1" />
                          <circle cx="15.2" cy="5.2" r="1" />
                        </>
                      )}
                      {servicio.icon === "blossom" && (
                        <>
                          <circle cx="12" cy="12" r="1.8" />
                          <path d="M12 3.5c1.6 2.2 1.6 4.5 0 6.5-1.6-2-1.6-4.3 0-6.5Z" />
                          <path d="M12 20.5c1.6-2.2 1.6-4.5 0-6.5-1.6 2-1.6 4.3 0 6.5Z" />
                          <path d="M3.5 12c2.2-1.6 4.5-1.6 6.5 0-2 1.6-4.3 1.6-6.5 0Z" />
                          <path d="M20.5 12c-2.2-1.6-4.5-1.6-6.5 0 2 1.6 4.3 1.6 6.5 0Z" />
                        </>
                      )}
                    </svg>
                  </div>
                </div>
              )}
              <div class="absolute inset-x-0 bottom-0 p-6">
                <h3 class="font-display text-xl text-surface">{servicio.title}</h3>
                <a
                  href={whatsappHref(servicio.mensaje)}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="mt-3 inline-block text-xs font-semibold uppercase tracking-wide text-gold-light transition-colors hover:text-gold"
                >
                  Ver masaje →
                </a>
              </div>
            </div>
          ))
        }

        <a
          href={whatsappHref("¡Hola! Busco un masaje y quisiera saber qué me recomiendan.")}
          target="_blank"
          rel="noopener noreferrer"
          class="swiper-slide stall stall-cta flex aspect-[4/5] flex-col justify-center rounded-lg border border-gold/40 bg-primary p-8 text-center shadow-lg transition-[transform,opacity] duration-300 hover:-translate-y-1"
        >
          <p class="font-display text-xl text-surface">¿Buscas algo más?</p>
          <p class="mt-2 text-sm text-background-alt">
            Escríbenos y te ayudamos a encontrar la terapia ideal para ti.
          </p>
          <span class="mt-4 text-xs font-semibold uppercase tracking-wide text-gold-light">
            Escribir por WhatsApp →
          </span>
        </a>
      </div>
    </div>
  </div>
</section>

<style>
  .stall-cta,
  .stall-texture {
    background-image: repeating-linear-gradient(
      135deg,
      var(--color-gold-dark) 0,
      var(--color-gold-dark) 2px,
      transparent 2px,
      transparent 12px
    );
    background-blend-mode: overlay;
    background-size: 100% 100%;
  }

  .servicios-prev:global(.swiper-button-disabled),
  .servicios-next:global(.swiper-button-disabled) {
    opacity: 0.3;
    pointer-events: none;
  }
</style>

<script>
  import Swiper from "swiper";
  import { Navigation } from "swiper/modules";
  import "swiper/css";

  const el = document.querySelector<HTMLElement>(".servicios-swiper");
  if (el) {
    new Swiper(el, {
      modules: [Navigation],
      slidesPerView: 1.15,
      spaceBetween: 16,
      watchOverflow: true,
      breakpoints: {
        640: { slidesPerView: 1.8, spaceBetween: 20 },
        768: { slidesPerView: 2.3, spaceBetween: 24 },
        1024: { slidesPerView: 2.8, spaceBetween: 24 },
        1280: { slidesPerView: 3.5, spaceBetween: 24 },
      },
      navigation: {
        nextEl: ".servicios-next",
        prevEl: ".servicios-prev",
      },
    });
  }
</script>

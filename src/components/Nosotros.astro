---
import { Image } from "astro:assets";
import local from "../assets/images/manos sagradas local 02.webp";
import piedrasCalientes from "../assets/images/manos sagradas masajes 03.webp";
import ambiente from "../assets/images/manos sagradas masajes 06.webp";
import adventureBg from "../assets/background/adventure-bg.webp";

const whatsappNumber = "51907529233";
const whatsappHref = `https://wa.me/${whatsappNumber}?text=${encodeURIComponent(
  "¡Hola! Quisiera contarles qué necesito antes de reservar mi masaje, ¿me ayudan?",
)}`;

const credenciales = [
  {
    label: "Atención 100% personalizada",
    detail: "Cada sesión se adapta a lo que tu cuerpo necesita ese día.",
  },
  {
    label: "Ambiente tranquilo y cómodo",
    detail: "Un espacio pensado para detener el ruido y soltar el estrés.",
  },
  {
    label: "En el corazón de Cusco",
    detail: "A pasos de la Plazoleta Belén, en un espacio cálido y sereno.",
  },
];
---

<section
  id="nosotros"
  class="bg-surface bg-repeat py-20 sm:py-28"
  style={`background-image: url(${adventureBg.src})`}
>
  <div
    class="mx-auto grid max-w-7xl gap-12 px-6 lg:grid-cols-2 lg:items-center lg:gap-16 lg:px-10"
  >
    <div class="mx-auto w-full max-w-md p-8 lg:mx-0 lg:p-10">
      <div class="relative">
        <div class="absolute -inset-3 rounded-lg border border-gold/40"></div>
        <Image
          src={local}
          alt="Sala de masajes de Manos Sagradas Masajes en Cusco"
          class="aspect-[4/5] w-full rounded-lg object-cover shadow-xl"
          widths={[400, 640, 800]}
          sizes="(min-width: 1024px) 32rem, 90vw"
        />

        <div
          class="absolute -bottom-8 -left-8 h-32 w-32 overflow-hidden rounded-full border-4 border-surface shadow-lg sm:-bottom-10 sm:-left-10 sm:h-40 sm:w-40"
        >
          <Image
            src={piedrasCalientes}
            alt="Masaje con piedras calientes en Manos Sagradas Masajes"
            class="h-full w-full object-cover"
            widths={[200, 300]}
            sizes="10rem"
          />
        </div>
        <div
          class="absolute -top-8 -right-8 h-28 w-28 overflow-hidden rounded-full border-4 border-surface shadow-lg sm:-top-10 sm:-right-10 sm:h-36 sm:w-36"
        >
          <Image
            src={ambiente}
            alt="Ambiente cálido de Manos Sagradas Masajes"
            class="h-full w-full object-cover"
            widths={[200, 300]}
            sizes="9rem"
          />
        </div>
      </div>
    </div>

    <div class="max-w-xl">
      <h2 class="font-display text-3xl font-semibold text-text sm:text-4xl">
        Un espacio pensado para ti
      </h2>
      <p class="mt-5 text-base leading-relaxed text-text-muted sm:text-lg">
        En Manos Sagradas creamos un lugar para detener el ruido, soltar el
        estrés y regalarte un momento de cuidado personal. Cada sesión es
        personalizada, en un ambiente tranquilo y cómodo, diseñado para tu
        bienestar. Porque cuando cuidas de ti, todo fluye mejor.
      </p>

      <ul class="mt-8 space-y-6 border-t border-background-alt pt-8">
        {
          credenciales.map((item) => (
            <li class="flex gap-4 items-center">
              <span class="mt-1.5 h-2 w-2 shrink-0 rounded-full bg-gold" />
              <div>
                <p class="font-display text-lg text-text">{item.label}</p>
                <p class="mt-1 text-sm text-text-muted">{item.detail}</p>
              </div>
            </li>
          ))
        }
      </ul>

      <a
        href={whatsappHref}
        target="_blank"
        rel="noopener noreferrer"
        class="mt-8 inline-flex items-center gap-2 rounded-lg bg-gold px-8 py-3 text-sm font-semibold tracking-wide text-surface transition-colors hover:bg-gold-dark sm:text-base"
      >
        <svg
          viewBox="0 0 24 24"
          fill="currentColor"
          class="h-5 w-5 shrink-0"
          aria-hidden="true"
        >
          <path
            d="M12.04 2c-5.5 0-9.96 4.46-9.96 9.96 0 1.76.46 3.48 1.34 5L2 22l5.2-1.36a9.9 9.9 0 0 0 4.84 1.23h.01c5.5 0 9.96-4.45 9.96-9.95S17.54 2 12.04 2Zm5.8 14.24c-.24.68-1.4 1.3-1.94 1.38-.5.08-1.12.11-1.8-.12a17 17 0 0 1-1.87-.7 12.7 12.7 0 0 1-4.9-4.34c-.6-.82-1-1.75-1-2.7 0-.9.47-1.36.8-1.7.2-.2.44-.28.6-.28h.42c.14 0 .33-.02.5.4.2.5.66 1.7.72 1.83.06.13.1.28.02.44-.08.16-.13.27-.26.42-.14.14-.28.32-.4.43-.13.13-.27.28-.12.55.16.28.7 1.14 1.5 1.85 1.03.92 1.9 1.2 2.18 1.34.28.13.44.11.6-.06.17-.18.7-.8.9-1.08.19-.28.38-.23.63-.14.26.1 1.6.75 1.87.89.28.13.46.2.53.31.07.12.07.68-.17 1.36Z"
          ></path>
        </svg>
        Cuéntanos qué necesitas
      </a>
    </div>
  </div>
</section>

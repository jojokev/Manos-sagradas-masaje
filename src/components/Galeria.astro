---
import { Image } from "astro:assets";
import Titulo from "./Titulo.astro";
import masaje01 from "../assets/images/manos sagradas masajes 01.webp";
import masaje02 from "../assets/images/manos sagradas masajes 02.webp";
import masaje03 from "../assets/images/manos sagradas masajes 03.webp";
import masaje04 from "../assets/images/manos sagradas masajes 04.webp";
import masaje05 from "../assets/images/manos sagradas masajes 05.webp";
import masaje06 from "../assets/images/manos sagradas masajes 06.webp";
import local01 from "../assets/images/manos sagradas local 01.webp";
import local02 from "../assets/images/manos sagradas local 02.webp";

// Siempre 11 fotos. La primera ocupa 2 columnas en todos los anchos (2/3/4 columnas
// según el breakpoint) y las otras 10 son 1x1, así el total de celdas (2 + 10 = 12)
// es múltiplo exacto de 2, 3 y 4 columnas: el grid siempre queda completo, sin huecos.
const fotos = [
  { title: "Descontracturante", image: masaje01, span: "col-span-2" },
  { title: "Relajante", image: masaje02, span: "" },
  { title: "Piedras calientes", image: masaje03, span: "" },
  { title: "Terapéutico", image: masaje04, span: "" },
  { title: "Drenaje linfático", image: masaje05, span: "" },
  { title: "Prenatal", image: masaje06, span: "" },
  { title: "Nuestro espacio", image: local01, span: "" },
  { title: "Nuestro espacio", image: local02, span: "" },
  { title: "Relajante", image: masaje02, span: "" },
  { title: "Terapéutico", image: masaje04, span: "" },
  { title: "Nuestro espacio", image: local02, span: "" },
];
---

<section id="galeria" class="bg-surface py-12 sm:py-16">
  <div class="mx-auto max-w-7xl px-6 lg:px-10">
    <div class="mx-auto max-w-2xl" data-reveal="fade-up">
      <Titulo parte1="Nuestra" parte2="Galería" />
      <p
        class="mt-4 text-center text-base text-text-muted sm:text-lg"
        data-reveal="fade-up"
        style="--reveal-delay: 120ms"
      >
        Un vistazo a nuestros momentos de cuidado personal.
      </p>
    </div>

    <div
      class="mt-12 grid grid-cols-2 auto-rows-[9rem] gap-4 sm:grid-cols-3 sm:auto-rows-[11rem] sm:gap-6 lg:grid-cols-4 lg:auto-rows-[12rem]"
    >
      {
        fotos.map((foto, index) => (
          <a
            href={foto.image.src}
            class:list={[
              "glightbox group relative block overflow-hidden rounded-lg shadow-lg",
              foto.span,
            ]}
            data-gallery="galeria"
            data-title={foto.title}
            data-reveal="zoom-in"
            style={`--reveal-delay: ${Math.min(index * 60, 480)}ms`}
          >
            <Image
              src={foto.image}
              alt={`${foto.title} en Manos Sagradas Masajes`}
              class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-105"
              widths={[300, 450, 700]}
              sizes="(min-width: 1024px) 30vw, (min-width: 640px) 40vw, 45vw"
            />
            <div class="pointer-events-none absolute inset-0 bg-gradient-to-t from-primary-dark/85 via-primary-dark/0 to-transparent opacity-0 transition-opacity duration-300 group-hover:opacity-100" />
            <span class="absolute inset-x-0 bottom-0 translate-y-2 p-4 text-sm font-semibold text-surface opacity-0 transition-all duration-300 group-hover:translate-y-0 group-hover:opacity-100">
              {foto.title}
            </span>
          </a>
        ))
      }
    </div>
  </div>
</section>

<script>
  import GLightbox from "glightbox";
  import "glightbox/dist/css/glightbox.min.css";

  GLightbox({ selector: ".glightbox", loop: true });
</script>

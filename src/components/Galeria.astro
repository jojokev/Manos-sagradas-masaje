---
import { Image } from "astro:assets";
import piedrasCalientes from "../assets/images/manos sagradas masajes 03.webp";
import descontracturante from "../assets/images/manos sagradas masajes 01.webp";
import relajante from "../assets/images/manos sagradas masajes 02.webp";

// Agregar más fotos aquí cuando estén disponibles (ambiente, local, terapeutas en sesión).
const fotos = [
  { src: piedrasCalientes, alt: "Masaje con piedras calientes en Manos Sagradas Masajes", tall: true },
  { src: descontracturante, alt: "Masaje descontracturante de cuello y hombros" },
  { src: relajante, alt: "Masaje facial relajante con aceites cálidos" },
];
---

<section id="galeria" class="bg-surface py-20 sm:py-28">
  <div class="mx-auto max-w-7xl px-6 lg:px-10">
    <h2 class="font-display text-3xl font-semibold text-text sm:text-4xl">Galería</h2>
    <p class="mt-4 max-w-2xl text-base text-text-muted sm:text-lg">
      Un vistazo a nuestros momentos de cuidado personal.
    </p>

    <div class="mt-12 grid grid-cols-2 gap-4 sm:grid-cols-3 sm:gap-6">
      {
        fotos.map((foto) => (
          <div
            class:list={[
              "group relative overflow-hidden rounded-2xl",
              foto.tall ? "col-span-2 sm:col-span-1 sm:row-span-2" : "col-span-1",
            ]}
          >
            <Image
              src={foto.src}
              alt={foto.alt}
              class:list={[
                "h-full w-full object-cover transition-transform duration-500 group-hover:scale-105",
                foto.tall ? "aspect-[4/5] sm:aspect-auto" : "aspect-square",
              ]}
              widths={[300, 500, 700]}
              sizes="(min-width: 640px) 30vw, 45vw"
            />
            <div class="pointer-events-none absolute inset-0 bg-gradient-to-t from-primary-dark/50 via-transparent to-transparent opacity-0 transition-opacity duration-300 group-hover:opacity-100" />
          </div>
        ))
      }
    </div>
  </div>
</section>

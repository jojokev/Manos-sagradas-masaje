---
import { Image } from "astro:assets";
import { getCollection } from "astro:content";
import Titulo from "./Titulo.astro";
import local56 from "../assets/images/local/manossagradasmasajes-56.webp";
import local57 from "../assets/images/local/manossagradasmasajes-57.webp";
import relajante20 from "../assets/images/Relajante/manossagradasmasajes-20.webp";
import descontracturante59 from "../assets/images/Descontracturante/manossagradasmasajes-59.webp";

// Mismo orden que "Nuestras terapias" y el footer.
const ordenServicios = [
  "relajante",
  "descontracturante",
  "terapeutico",
  "drenaje-linfatico",
  "reflexologia-podal",
  "piedras-calientes",
  "prenatal",
];

const todosLosServicios = await getCollection("servicios");
const serviciosOrdenados = ordenServicios
  .map((slug) => todosLosServicios.find((entry) => entry.id === slug))
  .filter((entry): entry is (typeof todosLosServicios)[number] =>
    Boolean(entry),
  );

// Siempre 11 fotos. La primera ocupa 2 columnas en todos los anchos (2/3/4 columnas
// según el breakpoint) y las otras 10 son 1x1, así el total de celdas (2 + 10 = 12)
// es múltiplo exacto de 2, 3 y 4 columnas: el grid siempre queda completo, sin huecos.
const fotos = [
  // Imagen destacada de cada servicio, con el nombre del servicio como texto.
  ...serviciosOrdenados.map((servicio, index) => ({
    title: servicio.data.titulo,
    image: servicio.data.imagenDestacada,
    span: index === 0 ? "col-span-2" : "",
  })),
  // Fotos del espacio.
  { title: "Manos Sagradas Masajes", image: local56, span: "" },
  { title: "Manos Sagradas Masajes", image: local57, span: "" },
  // Relleno para completar las 12 celdas del grid.
  { title: "Relajante", image: relajante20, span: "" },
  { title: "Descontracturante", image: descontracturante59, span: "" },
];
---

<section id="galeria" class="bg-surface py-12 sm:py-16">
  <div class="mx-auto max-w-7xl px-6 lg:px-10">
    <div class="mx-auto max-w-2xl" data-reveal="fade-up">
      <Titulo parte1="Nuestra" parte2="Galería" />
      <p
        class="mt-4 text-center text-base text-text-muted sm:text-lg"
        data-reveal="fade-up"
        style="--reveal-delay: 120ms"
      >
        Un vistazo a nuestros momentos de cuidado personal.
      </p>
    </div>

    <div
      class="mt-12 grid grid-cols-2 auto-rows-[9rem] gap-4 sm:grid-cols-3 sm:auto-rows-[11rem] sm:gap-6 lg:grid-cols-4 lg:auto-rows-[12rem]"
    >
      {
        fotos.map((foto, index) => (
          <a
            href={foto.image.src}
            class:list={[
              "glightbox group relative block overflow-hidden rounded-lg shadow-lg",
              foto.span,
            ]}
            data-gallery="galeria"
            data-title={foto.title}
            data-reveal="zoom-in"
            style={`--reveal-delay: ${Math.min(index * 60, 480)}ms`}
          >
            <Image
              src={foto.image}
              alt={`${foto.title} en Manos Sagradas Masajes`}
              class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-105"
              widths={[300, 450, 700]}
              sizes="(min-width: 1024px) 30vw, (min-width: 640px) 40vw, 45vw"
            />
            <div class="pointer-events-none absolute inset-0 bg-gradient-to-t from-primary-dark/85 via-primary-dark/0 to-transparent opacity-0 transition-opacity duration-300 group-hover:opacity-100" />
            <span class="absolute inset-x-0 bottom-0 translate-y-2 p-4 text-sm font-semibold text-surface opacity-0 transition-all duration-300 group-hover:translate-y-0 group-hover:opacity-100">
              {foto.title}
            </span>
          </a>
        ))
      }
    </div>
  </div>
</section>

<script>
  import GLightbox from "glightbox";
  import "glightbox/dist/css/glightbox.min.css";

  GLightbox({ selector: ".glightbox", loop: true });
</script>

---
import { Image } from "astro:assets";
import piedrasCalientes from "../assets/images/manos sagradas masajes 03.webp";
import descontracturante from "../assets/images/manos sagradas masajes 01.webp";
import relajante from "../assets/images/manos sagradas masajes 02.webp";
import terapeutico from "../assets/images/manos sagradas masajes 04.webp";
import drenajeLinfatico from "../assets/images/manos sagradas masajes 05.webp";
import prenatal from "../assets/images/manos sagradas masajes 06.webp";
import local from "../assets/images/manos sagradas local 02.webp";

const whatsappNumber = "51907529233";

function whatsappHref(mensaje: string) {
  return `https://wa.me/${whatsappNumber}?text=${encodeURIComponent(mensaje)}`;
}

const fotos = [
  {
    title: "Piedras calientes",
    image: piedrasCalientes,
    mensaje: "¡Hola! Me interesa el masaje con piedras calientes, ¿me cuentan más?",
  },
  {
    title: "Descontracturante",
    image: descontracturante,
    mensaje: "¡Hola! Me interesa el masaje descontracturante, ¿me cuentan más?",
  },
  {
    title: "Relajante",
    image: relajante,
    mensaje: "¡Hola! Me interesa el masaje relajante, ¿me cuentan más?",
  },
  {
    title: "Terapéutico",
    image: terapeutico,
    mensaje: "¡Hola! Me interesa el masaje terapéutico, ¿me cuentan más?",
  },
  {
    title: "Drenaje linfático",
    image: drenajeLinfatico,
    mensaje: "¡Hola! Me interesa el masaje de drenaje linfático, ¿me cuentan más?",
  },
  {
    title: "Prenatal",
    image: prenatal,
    mensaje: "¡Hola! Me interesa el masaje prenatal, ¿me cuentan más?",
  },
  {
    title: "Nuestro espacio",
    image: local,
    mensaje: "¡Hola! Me gustaría conocer más sobre su espacio y sus terapias.",
  },
];

const galeriaData = fotos.map((foto) => ({
  title: foto.title,
  href: whatsappHref(foto.mensaje),
}));
---

<section id="galeria" class="bg-surface py-20 sm:py-28">
  <div class="mx-auto max-w-7xl px-6 lg:px-10">
    <h2 class="font-display text-3xl font-semibold text-text sm:text-4xl">Galería</h2>
    <p class="mt-4 max-w-2xl text-base text-text-muted sm:text-lg">
      Un vistazo a nuestros momentos de cuidado personal.
    </p>

    <div class="mt-12 grid gap-6 overflow-x-hidden lg:grid-cols-2 lg:items-stretch">
      <div
        class="galeria-main swiper h-96 overflow-hidden rounded-lg shadow-xl sm:h-[28rem] lg:h-[32rem]"
        data-fotos={JSON.stringify(galeriaData)}
      >
        <div class="swiper-wrapper">
          {
            fotos.map((foto) => (
              <div class="swiper-slide h-full w-full">
                <Image
                  src={foto.image}
                  alt={`${foto.title} en Manos Sagradas Masajes`}
                  class="h-full w-full object-cover"
                  widths={[400, 640, 900]}
                  sizes="(min-width: 1024px) 45vw, 90vw"
                />
              </div>
            ))
          }
        </div>
      </div>

      <div class="flex flex-col justify-between gap-8 rounded-lg border border-background-alt bg-background p-8 lg:p-10">
        <div>
          <p class="text-xs font-semibold uppercase tracking-wide text-gold-dark">
            Manos Sagradas Masajes
          </p>
          <h3 class="galeria-title mt-2 font-display text-2xl text-text sm:text-3xl">
            {fotos[0].title}
          </h3>
          <p class="mt-3 text-sm text-text-muted">
            Horario: lunes a sábado, 9:00 a.m. – 6:00 p.m.
          </p>
          <a
            href={galeriaData[0].href}
            target="_blank"
            rel="noopener noreferrer"
            class="galeria-cta mt-6 inline-block rounded-lg bg-gold px-6 py-3 text-xs font-semibold uppercase tracking-wide text-surface transition-colors hover:bg-gold-dark"
          >
            Reservar por WhatsApp
          </a>
        </div>

        <div class="relative">
          <div class="galeria-thumbs swiper">
            <div class="swiper-wrapper">
              {
                fotos.map((foto) => (
                  <div class="swiper-slide cursor-pointer overflow-hidden rounded-lg">
                    <Image
                      src={foto.image}
                      alt={`${foto.title} en Manos Sagradas Masajes`}
                      class="aspect-square w-full object-cover"
                      widths={[150, 250]}
                      sizes="6rem"
                    />
                  </div>
                ))
              }
            </div>
          </div>
          <button
            type="button"
            class="galeria-prev absolute left-0 top-1/2 z-10 flex h-8 w-8 -translate-x-3 -translate-y-1/2 items-center justify-center rounded-lg bg-gold text-surface shadow-lg transition-colors hover:bg-gold-dark"
            aria-label="Foto anterior"
          >
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-4 w-4" aria-hidden="true">
              <path d="M15 6l-6 6 6 6" />
            </svg>
          </button>
          <button
            type="button"
            class="galeria-next absolute right-0 top-1/2 z-10 flex h-8 w-8 -translate-y-1/2 translate-x-3 items-center justify-center rounded-lg bg-gold text-surface shadow-lg transition-colors hover:bg-gold-dark"
            aria-label="Foto siguiente"
          >
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-4 w-4" aria-hidden="true">
              <path d="M9 6l6 6-6 6" />
            </svg>
          </button>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .galeria-main {
    width: 100%;
  }
  .galeria-main :global(.swiper-slide) {
    width: 100% !important;
    height: 100% !important;
  }

  .galeria-thumbs .swiper-slide {
    opacity: 0.5;
    transition: opacity 0.3s;
  }
  .galeria-thumbs :global(.swiper-slide-thumb-active) {
    opacity: 1;
    outline: 2px solid var(--color-gold);
    outline-offset: 2px;
  }
</style>

<script>
  import Swiper from "swiper";
  import { Thumbs, Navigation } from "swiper/modules";
  import "swiper/css";

  const mainEl = document.querySelector<HTMLElement>(".galeria-main");
  const thumbsEl = document.querySelector<HTMLElement>(".galeria-thumbs");
  const titleEl = document.querySelector<HTMLElement>(".galeria-title");
  const ctaEl = document.querySelector<HTMLAnchorElement>(".galeria-cta");

  if (mainEl && thumbsEl && titleEl && ctaEl) {
    const datos = JSON.parse(mainEl.dataset.fotos ?? "[]") as { title: string; href: string }[];

    const thumbsSwiper = new Swiper(thumbsEl, {
      slidesPerView: 3,
      spaceBetween: 12,
      watchSlidesProgress: true,
    });

    const mainSwiper = new Swiper(mainEl, {
      modules: [Thumbs, Navigation],
      slidesPerView: 1,
      thumbs: { swiper: thumbsSwiper },
      navigation: {
        nextEl: ".galeria-next",
        prevEl: ".galeria-prev",
      },
    });

    mainSwiper.on("slideChange", () => {
      const foto = datos[mainSwiper.activeIndex];
      if (!foto) return;
      titleEl.textContent = foto.title;
      ctaEl.href = foto.href;
    });

    window.addEventListener("load", () => {
      thumbsSwiper.update();
      mainSwiper.update();
    });
  }
</script>

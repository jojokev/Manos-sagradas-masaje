---
import "../global.css";
import Header from "../components/Header.astro";

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "Manos Sagradas Masajes | Spa de masajes en Cusco",
  description = "Masajes terapéuticos y relajantes en Cusco. Recupera tu equilibrio, cuerpo y mente con Manos Sagradas Masajes.",
} = Astro.props;
---

<!doctype html>
<html lang="es" class="scroll-smooth">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link
      rel="icon"
      type="image/x-icon"
      sizes="32x32"
      href="/Icon_manos_sagradasx32.ico"
    />
    <link
      rel="icon"
      type="image/x-icon"
      sizes="64x64"
      href="/Icon_manos_sagradasx64.ico"
    />
    <link rel="shortcut icon" href="/Icon_manos_sagradasx32.ico" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />
    <title>{title}</title>
    <meta
      name="google-site-verification"
      content="BRkbUrx1M4a5WSnA5JhlrrHPE6pXwjegjyZLWsrDykU"
    />
  </head>
  <body class="bg-background font-sans text-text antialiased">
    <Header />
    <slot />
  </body>
</html>

<style>
  html,
  body {
    margin: 0;
    width: 100%;
    min-height: 100%;
  }
</style>

<script>
  // Revela elementos [data-reveal] cuando entran en viewport. Se llama de
  // entrada (no hay <ClientRouter /> montado, así que "astro:page-load" no
  // se dispara todavía) y también queda enganchado a ese evento por si en el
  // futuro se activa el router de vistas.
  function initScrollReveal() {
    const elementos = document.querySelectorAll<HTMLElement>(
      "[data-reveal]:not(.is-revealed)",
    );
    if (!elementos.length) return;

    if (!("IntersectionObserver" in window)) {
      elementos.forEach((el) => el.classList.add("is-revealed"));
      return;
    }

    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            entry.target.classList.add("is-revealed");
            observer.unobserve(entry.target);
          }
        });
      },
      { threshold: 0.15, rootMargin: "0px 0px -8% 0px" },
    );

    elementos.forEach((el) => observer.observe(el));
  }

  initScrollReveal();
  document.addEventListener("astro:page-load", initScrollReveal);
</script>

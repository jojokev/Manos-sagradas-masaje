---
import "../global.css";

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "Manos Sagradas Masajes | Spa de masajes en Cusco",
  description = "Masajes terapéuticos y relajantes en Cusco. Recupera tu equilibrio, cuerpo y mente con Manos Sagradas Masajes.",
} = Astro.props;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/x-icon" sizes="32x32" href="/Icon_manos_sagradasx32.ico" />
    <link rel="icon" type="image/x-icon" sizes="64x64" href="/Icon_manos_sagradasx64.ico" />
    <link rel="shortcut icon" href="/Icon_manos_sagradasx32.ico" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=Playfair+Display:wght@600;700&display=swap"
      rel="stylesheet"
    />
    <title>{title}</title>
  </head>
  <body class="bg-background font-sans text-text antialiased">
    <slot />
  </body>
</html>

<style>
  html,
  body {
    margin: 0;
    width: 100%;
    height: 100%;
  }
</style>

---
import { getCollection, type CollectionEntry } from "astro:content";
import { Image } from "astro:assets";
import Layout from "../../layouts/Layout.astro";
import Footer from "../../components/Footer.astro";

export async function getStaticPaths() {
  const entries = await getCollection("servicios");
  return entries.map((entry) => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}

type Props = { entry: CollectionEntry<"servicios"> };
const { entry } = Astro.props;
const {
  titulo,
  tagline,
  calificacion,
  precio,
  categorias,
  idealPara,
  descripcionCorta,
  descripcionDetallada,
  imagenDestacada,
  imagenes,
} = entry.data;

const whatsappNumber = "51907529233";
const mensaje = `¡Hola! Me interesa el servicio de ${titulo}, ¿me cuentan más?`;
const whatsappHref = `https://wa.me/${whatsappNumber}?text=${encodeURIComponent(mensaje)}`;

const estrellas = Array.from({ length: 5 }, (_, i) => i < Math.round(calificacion));

const parrafosDetalle = descripcionDetallada
  .split(/\n{2,}/)
  .map((parrafo) => parrafo.trim())
  .filter(Boolean);
---

<Layout
  title={`${titulo} | Manos Sagradas Masajes`}
  description={descripcionCorta}
>
  <section class="bg-background py-16 sm:py-20">
    <div class="mx-auto max-w-7xl px-6 lg:px-10">
      <div class="grid gap-10 lg:grid-cols-2 lg:gap-14">
        <div class="overflow-hidden rounded-lg bg-primary shadow-lg">
          <Image
            src={imagenDestacada}
            alt={`Terapia ${titulo} en Manos Sagradas Masajes`}
            class="aspect-square w-full object-cover"
            widths={[400, 640, 800]}
            sizes="(min-width: 1024px) 32rem, 100vw"
          />
        </div>

        <div>
          {tagline && (
            <p class="text-sm font-medium italic text-gold-dark">{tagline}</p>
          )}
          <h1 class="mt-2 font-display text-3xl font-semibold text-text sm:text-4xl">
            {titulo}
          </h1>

          <div
            class="mt-3 flex items-center gap-1"
            aria-label={`Calificación ${calificacion} de 5`}
          >
            {
              estrellas.map((activa) => (
                <svg
                  viewBox="0 0 20 20"
                  fill="currentColor"
                  class={`h-5 w-5 ${activa ? "text-gold" : "text-background-alt"}`}
                  aria-hidden="true"
                >
                  <path d="M10 1.5l2.6 5.4 5.9.8-4.3 4.2 1 5.9L10 15l-5.2 2.8 1-5.9-4.3-4.2 5.9-.8L10 1.5Z" />
                </svg>
              ))
            }
          </div>

          {
            precio ? (
              <p class="mt-4 font-display text-2xl font-semibold text-primary">
                S/ {precio.toFixed(2)}
              </p>
            ) : (
              <p class="mt-4 text-sm font-medium uppercase tracking-wide text-text-muted">
                Consulta el precio por WhatsApp
              </p>
            )
          }

          <p class="mt-4 max-w-prose text-base leading-relaxed text-text-muted">
            {descripcionCorta}
          </p>

          {
            idealPara && (
              <p class="mt-3 text-xs font-semibold uppercase tracking-wide text-gold-dark">
                Ideal para: {idealPara}
              </p>
            )
          }

          <a
            href={whatsappHref}
            target="_blank"
            rel="noopener noreferrer"
            class="mt-6 inline-block rounded-lg bg-gold px-8 py-3 text-sm font-semibold tracking-wide text-surface transition-colors hover:bg-gold-dark sm:text-base"
          >
            Reservar {titulo} por WhatsApp
          </a>

          {
            categorias.length > 0 && (
              <div class="mt-6 border-t border-background-alt pt-6">
                <p class="text-sm text-text-muted">
                  <span class="font-semibold text-text">Categorías:</span>{" "}
                  {categorias.join(", ")}
                </p>
              </div>
            )
          }

          <div class="mt-6 border-t border-background-alt pt-6">
            <p class="text-sm font-semibold text-text">Compartir:</p>
            <div class="mt-3 flex items-center gap-3">
              <button
                type="button"
                data-share="facebook"
                aria-label="Compartir en Facebook"
                class="flex h-9 w-9 items-center justify-center rounded-lg border border-gold/30 text-text-muted transition-colors hover:border-gold hover:text-gold-dark"
              >
                <svg viewBox="0 0 24 24" fill="currentColor" class="h-4 w-4" aria-hidden="true">
                  <path d="M22 12.06C22 6.505 17.523 2 12 2S2 6.505 2 12.06c0 5.02 3.657 9.184 8.438 9.94v-7.03H7.898v-2.91h2.54V9.845c0-2.507 1.492-3.89 3.777-3.89 1.094 0 2.238.195 2.238.195v2.46h-1.26c-1.243 0-1.63.771-1.63 1.562v1.876h2.773l-.443 2.91h-2.33V22c4.78-.756 8.437-4.92 8.437-9.94Z" />
                </svg>
              </button>
              <button
                type="button"
                data-share="instagram"
                aria-label="Compartir en Instagram"
                class="flex h-9 w-9 items-center justify-center rounded-lg border border-gold/30 text-text-muted transition-colors hover:border-gold hover:text-gold-dark"
              >
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" class="h-4 w-4" aria-hidden="true">
                  <rect x="3" y="3" width="18" height="18" rx="5" />
                  <circle cx="12" cy="12" r="4" />
                  <circle cx="17.2" cy="6.8" r="1" fill="currentColor" stroke="none" />
                </svg>
              </button>
              <button
                type="button"
                data-share="tiktok"
                aria-label="Compartir en TikTok"
                class="flex h-9 w-9 items-center justify-center rounded-lg border border-gold/30 text-text-muted transition-colors hover:border-gold hover:text-gold-dark"
              >
                <svg viewBox="0 0 24 24" fill="currentColor" class="h-4 w-4" aria-hidden="true">
                  <path d="M16.6 3h-3.2v12.6a2.7 2.7 0 1 1-2.2-2.65v-3.24a6 6 0 1 0 5.4 5.97V9.1a6.9 6.9 0 0 0 4.1 1.34V7.24A3.9 3.9 0 0 1 16.6 3Z" />
                </svg>
              </button>
              <button
                type="button"
                data-share="whatsapp"
                aria-label="Compartir en WhatsApp"
                class="flex h-9 w-9 items-center justify-center rounded-lg border border-gold/30 text-text-muted transition-colors hover:border-gold hover:text-gold-dark"
              >
                <svg viewBox="0 0 24 24" fill="currentColor" class="h-4 w-4" aria-hidden="true">
                  <path d="M12.04 2c-5.5 0-9.96 4.46-9.96 9.96 0 1.76.46 3.48 1.34 5L2 22l5.2-1.36a9.9 9.9 0 0 0 4.84 1.23h.01c5.5 0 9.96-4.45 9.96-9.95S17.54 2 12.04 2Zm5.8 14.24c-.24.68-1.4 1.3-1.94 1.38-.5.08-1.12.11-1.8-.12a17 17 0 0 1-1.87-.7 12.7 12.7 0 0 1-4.9-4.34c-.6-.82-1-1.75-1-2.7 0-.9.47-1.36.8-1.7.2-.2.44-.28.6-.28h.42c.14 0 .33-.02.5.4.2.5.66 1.7.72 1.83.06.13.1.28.02.44-.08.16-.13.27-.26.42-.14.14-.28.32-.4.43-.13.13-.27.28-.12.55.16.28.7 1.14 1.5 1.85 1.03.92 1.9 1.2 2.18 1.34.28.13.44.11.6-.06.17-.18.7-.8.9-1.08.19-.28.38-.23.63-.14.26.1 1.6.75 1.87.89.28.13.46.2.53.31.07.12.07.68-.17 1.36Z" />
                </svg>
              </button>
            </div>
            <p
              id="share-feedback"
              class="mt-2 h-4 text-xs text-gold-dark opacity-0 transition-opacity"
              role="status"
            >
            </p>
          </div>
        </div>
      </div>

      {
        parrafosDetalle.length > 0 && (
          <div class="mt-16">
            <div class="rounded-lg bg-background-alt px-6 py-3 text-center">
              <h2 class="text-sm font-semibold uppercase tracking-widest text-primary-dark">
                Descripción
              </h2>
            </div>
            <div class="mt-6 max-w-prose">
              {parrafosDetalle.map((parrafo) => (
                <p class="mt-4 text-base leading-relaxed text-text-muted first:mt-0">
                  {parrafo}
                </p>
              ))}
            </div>
          </div>
        )
      }

      {
        imagenes.length >= 4 && (
          <div class="mt-16">
            <div class="rounded-lg bg-background-alt px-6 py-3 text-center">
              <h2 class="text-sm font-semibold uppercase tracking-widest text-primary-dark">
                Galería
              </h2>
            </div>
            <div class="mt-6 grid grid-cols-2 gap-4 sm:gap-6 lg:grid-cols-4">
              {imagenes.map((imagen, index) => (
                <a
                  href={imagen.src}
                  class="servicio-glightbox group block overflow-hidden rounded-lg shadow-md"
                  data-gallery={`servicio-${entry.id}`}
                  data-title={`${titulo} — foto ${index + 1}`}
                >
                  <Image
                    src={imagen}
                    alt={`Foto ${index + 1} de la terapia ${titulo} en Manos Sagradas Masajes`}
                    class="aspect-square w-full object-cover transition-transform duration-500 group-hover:scale-105"
                    widths={[240, 360, 480]}
                    sizes="(min-width: 1024px) 20rem, 45vw"
                  />
                </a>
              ))}
            </div>
          </div>
        )
      }
    </div>
  </section>

  <Footer />
</Layout>

<script>
  import GLightbox from "glightbox";
  import "glightbox/dist/css/glightbox.min.css";

  GLightbox({ selector: ".servicio-glightbox", loop: true });

  const feedback = document.getElementById("share-feedback");

  function mostrarFeedback(texto: string) {
    if (!feedback) return;
    feedback.textContent = texto;
    feedback.classList.remove("opacity-0");
    window.setTimeout(() => feedback.classList.add("opacity-0"), 2500);
  }

  document.querySelectorAll<HTMLButtonElement>("[data-share]").forEach((boton) => {
    boton.addEventListener("click", async () => {
      const red = boton.dataset.share;
      const url = window.location.href;
      const titulo = document.title;

      if (red === "facebook") {
        window.open(
          `https://www.facebook.com/sharer/sharer.php?u=${encodeURIComponent(url)}`,
          "_blank",
          "noopener,noreferrer",
        );
        return;
      }

      if (red === "whatsapp") {
        window.open(
          `https://wa.me/?text=${encodeURIComponent(`${titulo} ${url}`)}`,
          "_blank",
          "noopener,noreferrer",
        );
        return;
      }

      // Instagram y TikTok no ofrecen un intent web de compartir con URL, así que copiamos el enlace.
      try {
        await navigator.clipboard.writeText(url);
        mostrarFeedback("Enlace copiado. Pégalo en tu historia o mensaje.");
      } catch {
        mostrarFeedback(url);
      }
    });
  });
</script>
